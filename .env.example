# Google Gemini API key — used by POST /api/explain and the MCP explain_alert tool.
# OPTIONAL: the app is fully functional without it (explanations fall back to a
# deterministic template built from the fraud engine's signal reasons).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Bearer token required by the REMOTE MCP server (npm run mcp:remote).
# OPTIONAL for local demos: if unset, the server falls back to the insecure
# default "sentinel-dev-token" and logs a warning. Set a real value before
# exposing the server. See the README for swapping in full OAuth 2.1.
MCP_AUTH_TOKEN=

# Remote MCP: expose raw numeric scores to remote callers. Defaults to false so
# remote callers receive band + reasons only (threshold-oracle defense).
# EXPOSE_RAW_SCORE=false

# Remote MCP: port for the Streamable HTTP server (default 8848).
# MCP_REMOTE_PORT=8848
